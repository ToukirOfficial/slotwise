{
  "name": "@slotwise/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js & node --watch --env-file-if-exists=../../.env dist/worker.js & wait)",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "prisma generate && vitest run",
    "seed": "node --env-file-if-exists=../../.env dist/demo/seed-cli.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@slotwise/engine": "workspace:*",
    "@slotwise/shared": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.3",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "temporal-polyfill": "^1.0.6",
    "zod": "4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.5"
  }
}
