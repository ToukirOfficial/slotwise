# Copy to .env (pnpm run setup does this for you and fills in the secrets).
# Never put live keys here.
NODE_ENV=development

# Local ports (see ~/projects/PORTS.md)
WEB_PORT=8015
API_PORT=8115
WEB_URL=http://localhost:8015
# Next.js reads PORT in production (`next start`); keep it equal to WEB_PORT.
PORT=8015
API_URL=http://127.0.0.1:8115

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/slotwise_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/slotwise_test
REDIS_URL=redis://127.0.0.1:6379/0

# 32+ random bytes each (base64 or hex). ENCRYPTION_KEY must be exactly 32 bytes as 64 hex chars.
JWT_SECRET=
ENCRYPTION_KEY=
MANAGE_TOKEN_SECRET=

# Leave SMTP_URL empty locally: mail goes to the log and tmp/mail/*.eml.
SMTP_URL=
MAIL_FROM="Slotwise <no-reply@slotwise.example>"
